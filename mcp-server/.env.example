# Copia este archivo como ".env" y ajusta los valores. ".env" NO se sube a Git.

# Prefijo ÚNICO de tu grupo (evita interferir con otros grupos en el broker público)
TOPIC_PREFIX=sis234/grupoN

MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
# Solo si tu broker requiere autenticación (HiveMQ público no):
MQTT_USER=
MQTT_PASSWORD=

# Colores de los LEDs de tu objeto inteligente (separados por coma)
LED_COLORS=rojo,verde,amarillo

# Pon true si tu objeto tiene servomotor (activa la herramienta move_servo)
SERVO_ENABLED=false

# Segundos tras los cuales una lectura se considera antigua
STALE_AFTER_S=5
